# Multi-stage production build for Rust Instrument Gateway
FROM rust:1.75-slim as builder

WORKDIR /app

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo files
COPY src/instrument_gateway/Cargo.toml ./
COPY src/instrument_gateway/Cargo.lock ./

# Create a dummy main to cache dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

# Copy real source code
COPY src/instrument_gateway/src ./src/

# Build the application
RUN cargo build --release

# Production stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Create non-root user
RUN groupadd -r testpilot && useradd -r -g testpilot testpilot

# Create necessary directories
RUN mkdir -p /var/log/testpilot && \
    chown -R testpilot:testpilot /var/log/testpilot

# Copy the binary from builder stage
COPY --from=builder /app/target/release/instrument_gateway /usr/local/bin/instrument_gateway

# Copy configuration
COPY config/ /app/config/

# Set ownership
RUN chown -R testpilot:testpilot /app

# Switch to non-root user
USER testpilot

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["instrument_gateway"]
# Multi-stage production build for React Web Interface
FROM node:20-alpine as build

WORKDIR /app

# Copy package files
COPY src/web_interface/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY src/web_interface/ ./

# Build production bundle
RUN npm run build

# Production stage with nginx
FROM nginx:1.25-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy custom nginx configuration
COPY docker/web_interface/nginx.conf /etc/nginx/nginx.conf

# Copy build artifacts
COPY --from=build /app/build /usr/share/nginx/html

# Create non-root user
RUN addgroup -g 1001 -S testpilot && \
    adduser -S -D -H -u 1001 -s /sbin/nologin -G testpilot testpilot

# Set permissions
RUN chown -R testpilot:testpilot /usr/share/nginx/html && \
    chown -R testpilot:testpilot /var/cache/nginx && \
    chown -R testpilot:testpilot /var/log/nginx && \
    chown -R testpilot:testpilot /etc/nginx/conf.d

# Switch to non-root user
USER testpilot

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]